    "modes": {
      "mock": {
        "description": "Run the 100 Hz mock arm and 50 Hz SO-101 TensorRT reach policy.",
        "run": {
          "command": "<isaac_app_bin>/mock/mock_so101_reach",
          "workdir": "isaac_root"
        }
      },
