        "run": {
          "command": "<isaac_app_bin>/real/so101_reach_real",
          "workdir": "isaac_root"
        }
      },
      "sim": {
        "description": "Run the SO-101 TensorRT reach policy in Isaac Sim over UCX.",
        "run": {
          "command": "<isaac_app_bin>/sim/so101_reach_sim",
          "workdir": "isaac_root"
        }
      }
    },
