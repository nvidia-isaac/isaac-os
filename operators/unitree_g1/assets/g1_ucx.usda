    over "pelvis" (
        prepend apiSchemas = ["PhysxArticulationAPI"]
    )
    {
        # Raise position-solver iterations (PhysX default 4) to firm up foot/ground
        # contact and reduce interpenetration.
        uint physxArticulation:solverPositionIterationCount = 32
        uint physxArticulation:solverVelocityIterationCount = 4
        quatd xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        over "imu_in_pelvis" (
            prepend apiSchemas = ["IsaacSensorSchemaIsaacImuSensor"]
        )
        {
            bool isaacsensor:imu:enabled = 1
            float isaacsensor:imu:sensorPeriod = 0
        }
    }

