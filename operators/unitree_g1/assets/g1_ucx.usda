# Isaac Sim's built-in Simple Warehouse environment (ships its own floor, walls,
# and lighting). Resolved from the same Isaac 6.0 asset bundle as the robot.
def Xform "Environment" (
    prepend references = @https://omniverse-content-production.s3-us-west-2.amazonaws.com/Assets/Isaac/6.0/Isaac/Environments/Simple_Warehouse/warehouse.usd@
)
{
}

def PhysicsScene "PhysicsScene" (
    prepend apiSchemas = ["PhysxSceneAPI", "NewtonSceneAPI"]
)
{
    # 200 Hz physics; --substeps 4 sets 50 Hz control.
    uint physxScene:timeStepsPerSecond = 200
}
